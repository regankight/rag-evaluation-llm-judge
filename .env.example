# Copy this file to .env and fill in your own values. .env is git-ignored.

# Restricted OpenAI key: model access (Chat Completions) only.
OPENAI_API_KEY=sk-your-key-here

# Generator (decision record 0004). Reasoning must be "none" for temperature to be accepted.
GENERATOR_MODEL=gpt-6-luna

# Judge via Ollama (records 0002, 0005): qwen3:14b with a pinned 8k context window.
# Create it once: ollama create qwen3-14b-8k -f ollama/Modelfile.qwen3-14b-8k
JUDGE_MODEL=qwen3-14b-8k
OLLAMA_BASE_URL=http://localhost:11434/v1
